                                          # to calibrate the instrument
; ?
;

_diffrn_ambient_temperature           ?
_diffrn_source                        'X-ray tube'
_diffrn_source_target                 Cu
_diffrn_source_type                   ?
_diffrn_radiation_type                'Cu K\a~1~'
_diffrn_measurement_device_type       '?'
_diffrn_detector                      '?'
_diffrn_detector_type                 ?

_pd_meas_scan_method                  step    # options are 'step', 'cont',
                                              #' 'tof', 'fixed' or
                                              # 'disp' (= dispersive)
_pd_meas_special_details
; ?
;

_diffrn_radiation_wavelength          1.540590
_diffrn_radiation_monochromator       ?

# The following four items give details of the measured (not processed)
# powder pattern.  Angles are in degrees.

_pd_meas_number_of_points             5271
_pd_meas_2theta_range_min               9.4489
_pd_meas_2theta_range_max             100.9772
_pd_meas_2theta_range_inc               0.0170

# The following three items are used for time-of-flight measurements only.

_pd_instr_dist_src/spec               ?
_pd_instr_dist_spec/detc              ?
