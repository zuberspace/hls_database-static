_journal_coden_ASTM                  ?
_journal_name_full                   ?
_journal_year                        ?
_journal_volume                      ?
_journal_issue                       ?
_journal_page_first                  ?
_journal_page_last                   ?
_journal_paper_category              ?
_journal_suppl_publ_number           ?
_journal_suppl_publ_pages            ?

#===============================================================================

# 3. TITLE AND AUTHOR LIST

_publ_section_title
; ?
;
_publ_section_title_footnote
; ?
;

# The loop structure below should contain the names and addresses of all
# authors, in the required order of publication. Repeat as necessary.

loop_
   _publ_author_name
   _publ_author_footnote
   _publ_author_address
 ?                                   #<--'Last name, first name'
; ?
;
; ?
;

#===============================================================================

# 4. TEXT

_publ_section_synopsis
; ?
;
_publ_section_abstract
; ?
;
_publ_section_comment
; ?
;
_publ_section_exptl_prep      # Details of the preparation of the sample(s)
                              # should be given here.
; ?
;
_publ_section_exptl_refinement
; ?
;
_publ_section_references
; ?
;
_publ_section_figure_captions
; ?
;
_publ_section_acknowledgements
; ?
;

# Pointers to the data blocks containing information on phases
loop_
   _pd_phase_block_id
2016-11-04_phase_1
2016-11-04_phase_2

#===============================================================================

# If more than one structure is reported, sections 5-9 should be completed
# per structure. For each data set, replace the '?' in the data_? line below
# by a unique identifier.

#===============================================================================

data_phase_1

_pd_block_id   2016-11-04_phase_1

